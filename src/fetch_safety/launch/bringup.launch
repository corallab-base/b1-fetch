<launch>
  <!-- All safety cameras + safety filter in one command, run from .24:
         source ~/projects/fetch/env.sh
         roslaunch fetch_safety bringup.launch
       roslaunch starts roscore if none is running, and starts the front and
       rear cameras on .23/.25 over SSH (key auth; env-loader remote_env.sh).
       Each camera runs with its zone_checker on its own board (camera.launch);
       only per-zone counts reach the filter. Deploy code to all boards with
       ~/projects/fetch/deploy.sh first.
       Every camera is required: if any fails, the whole bringup stops.
       The B1 bridge is NOT started here: stand the robot up first, then
       launch it separately. -->
  <arg name="base_frame" default="base_link"/>
  <!-- Downward front camera (.23). Off by default: its mount pitch is still a
       placeholder. -->
  <arg name="front_down" default="false"/>

  <!-- Left / right (.24) -->
  <include file="$(find fetch_safety)/launch/side_cameras.launch">
    <arg name="base_frame" value="$(arg base_frame)"/>
  </include>

  <!-- Front/rear mounts. Positions from Unitree's b1_description
       (head_camera_1 xyz="0.48883 0 0.0255", tail_camera xyz="-0.459 0 -0.081");
       its rpy="0 0 0" is wrong for these cameras, so pitch comes from the
       floor check. args: x y z yaw pitch roll parent child (pitch + = down). -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_cam_front"
        args=" 0.48883 0  0.0255  0       0.0  0 $(arg base_frame) cam_front_link"/>
  <!-- Downward front camera: head_camera_2 position from the model; tilt is
       a PLACEHOLDER until solved from the floor plane. -->
  <node if="$(arg front_down)" pkg="tf2_ros" type="static_transform_publisher" name="tf_cam_front_down"
        args=" 0.4543  0 -0.081   0       0.82 0 $(arg base_frame) cam_front_down_link"/>
  <!-- Rear camera looks (almost) straight down, image-top toward the rear.
       Solved from its floor plane with the robot standing (2026-09-26):
       0.503 m above the floor (floor at z -0.575 per side cams) -> z -0.072;
       optical axis 88.7 deg down. Verified: floor lands at -0.575, only the
       hind legs are above it. Given as a quaternion (x y z qx qy qz qw):
       yaw/pitch/roll are near gimbal lock for a straight-down camera. -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_cam_rear"
        args="-0.459 0 -0.072  0.70565 -0.00776 -0.70848 0.00779 $(arg base_frame) cam_rear_link"/>

  <include file="$(find fetch_safety)/launch/safety_filter.launch">
    <arg name="front_camera" value="true"/>
    <arg name="front_down"   value="$(arg front_down)"/>
  </include>

  <!-- Remote cameras. KEEP THESE LAST: a <machine default="true"> is not
       scoped to its <group>, it applies to every node declared after it. -->
  <!-- Front (.23): the forward-looking head camera, plus the downward head
       camera that covers low obstacles close in front (the forward camera
       can't see below ~0.3 m within 1 m of the robot). -->
  <group>
    <machine name="nx23" address="192.168.123.23" user="unitree" timeout="30" default="true"
             env-loader="/home/unitree/projects/fetch/remote_env.sh"/>
    <!-- both .23 cameras in one driver process (see camera.launch) -->
    <node pkg="nodelet" type="nodelet" name="cam_manager_23" args="manager" output="screen" required="true"/>
    <include file="$(find fetch_safety)/launch/camera.launch">
      <arg name="camera"    value="cam_front"/>
      <arg name="serial_no" value="150622072829"/>
      <arg name="manager"   value="/cam_manager_23"/>
    </include>
    <include if="$(arg front_down)" file="$(find fetch_safety)/launch/camera.launch">
      <arg name="camera"    value="cam_front_down"/>
      <arg name="serial_no" value="150622071014"/>
      <arg name="manager"   value="/cam_manager_23"/>
    </include>
  </group>

  <!-- Rear (.25): tail camera, tilted steeply down; USB 2.1, so 480x270 -->
  <group>
    <machine name="nx25" address="192.168.123.25" user="unitree" timeout="30" default="true"
             env-loader="/home/unitree/projects/fetch/remote_env.sh"/>
    <include file="$(find fetch_safety)/launch/camera.launch">
      <arg name="camera"    value="cam_rear"/>
      <arg name="serial_no" value="150622073015"/>
      <arg name="width"     value="480"/>
      <arg name="height"    value="270"/>
    </include>
  </group>
</launch>
