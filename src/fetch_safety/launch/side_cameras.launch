<launch>
  <!-- Left and right D430i depth cameras (this board, .24) plus their
       mounting transforms. Mounts verified against the floor plane
       (floor flat at z = -0.55 when standing, 2026-09-26). -->
  <arg name="left_serial"  default="152122075367"/>
  <arg name="right_serial" default="150622073088"/>
  <arg name="base_frame"   default="base_link"/>
  <arg name="obstacle_cloud" default="true"/>

  <!-- both cameras in one driver process (see camera.launch) -->
  <node pkg="nodelet" type="nodelet" name="cam_manager_24" args="manager" output="screen" required="true"/>
  <include file="$(find fetch_safety)/launch/camera.launch">
    <arg name="camera"    value="cam_left"/>
    <arg name="serial_no" value="$(arg left_serial)"/>
    <arg name="manager"   value="/cam_manager_24"/>
    <arg name="obstacle_cloud" value="$(arg obstacle_cloud)"/>
  </include>
  <include file="$(find fetch_safety)/launch/camera.launch">
    <arg name="camera"    value="cam_right"/>
    <arg name="serial_no" value="$(arg right_serial)"/>
    <arg name="manager"   value="/cam_manager_24"/>
    <arg name="obstacle_cloud" value="$(arg obstacle_cloud)"/>
  </include>

  <!-- static_transform_publisher args: x y z yaw pitch roll parent child.
       Mount poses from Unitree's b1_description (unitree_ros, robot.xacro):
         left_side_camera_joint   xyz="-0.1086  0.1371 -0.03077" rpy="-0.331612 0 0"
         right_side_camera_joint  xyz="-0.10190 -0.1371 -0.03077" rpy=" 0.331612 0 0"
       i.e. both face sideways, tilted 19 deg down. camera_link has x along the
       optical axis, so: left yaw +90deg, right yaw -90deg, then pitch +0.3316
       (down). -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_cam_left"
        args="-0.1086  0.1371 -0.03077  1.5708 0.331612 0 $(arg base_frame) cam_left_link"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_cam_right"
        args="-0.1019 -0.1371 -0.03077 -1.5708 0.331612 0 $(arg base_frame) cam_right_link"/>
</launch>
