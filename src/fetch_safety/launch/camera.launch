<launch>
  <!-- One D430i depth camera publishing /<camera>/depth/color/points, and its
       zone_checker counting that cloud into the safety zones on the same
       board -> /<camera>/zone_counts, which is all the safety filter reads.
       The cloud only crosses the network while something on another board
       subscribes (Foxglove/RViz).
       Same settings for every safety camera, on whichever board it is plugged
       into. required: if a camera node or its checker dies, the whole
       bringup shuts down (and the bridge stops getting commands) instead of
       running with a blind side. -->
  <arg name="camera"/>
  <arg name="serial_no"/>
  <!-- 424x240 needs USB 3; the rear camera is on USB 2.1 and uses 480x270 -->
  <arg name="width"   default="424"/>
  <arg name="height"  default="240"/>
  <!-- temporal smooths noise but delays newly appearing obstacles.
       decimation (2x2, always applied first by realsense-ros) cuts each cloud
       4x: 424x240 -> 212x120, max ~49 Mbit/s instead of ~195 (rear ~62). -->
  <arg name="filters" default="decimation,pointcloud,spatial"/>
  <!-- Shared nodelet manager (absolute name, started by the caller). Two
       cameras on one board must share ONE driver process: with librealsense's
       RSUSB backend, separate processes can't enumerate each other's devices
       and both loop on "device ... is NOT found". Empty = own manager. -->
  <arg name="manager" default=""/>
  <!-- zones and height band; must be the filter's config (the filter ignores
       counts whose zone names don't match its own) -->
  <arg name="safety_config" default="$(find fetch_safety)/config/safety_filter.yaml"/>
  <!-- also publish the left infrared image (8-bit grayscale, same viewpoint
       as the depth) as infra1/image_rect_raw, e.g. for RTAB-Map place
       recognition. Shows the projector's dot pattern. -->
  <arg name="infra" default="false"/>
  <!-- the checker also publishes <camera>/obstacles: the height band's
       points thinned to 5 cm cubes at ~5 Hz, for RTAB-Map / move_base -->
  <arg name="obstacle_cloud" default="false"/>

  <group ns="$(arg camera)">
    <include file="$(find realsense2_camera)/launch/includes/nodelet.launch.xml">
      <arg name="tf_prefix"                 value="$(arg camera)"/>
      <arg name="serial_no"                 value="$(arg serial_no)"/>
      <arg name="filters"                   value="$(arg filters)"/>
      <arg name="pointcloud_texture_stream" value="RS2_STREAM_ANY"/>
      <arg name="enable_color"              value="false"/>
      <arg name="enable_infra1"             value="$(arg infra)"/>
      <arg name="infra_width"               value="$(arg width)"/>
      <arg name="infra_height"              value="$(arg height)"/>
      <arg name="infra_fps"                 value="15"/>
      <arg name="clip_distance"             value="3.0"/>
      <!-- Re-send the camera's internal frames on /tf instead of once on
           latched /tf_static: two cameras in one nodelet manager share one
           latched /tf_static message, so late subscribers (Foxglove) only
           got the last camera's frames. -->
      <arg name="tf_publish_rate"           value="10.0"/>
      <arg name="depth_width"               value="$(arg width)"/>
      <arg name="depth_height"              value="$(arg height)"/>
      <arg name="depth_fps"                 value="15"/>
      <arg name="initial_reset"             value="true"/>
      <arg name="required"                  value="true"/>
      <arg name="external_manager"          value="$(eval manager != '')"/>
      <arg name="manager"                   value="$(eval manager if manager != '' else 'realsense2_camera_manager')"/>
    </include>

    <node pkg="fetch_safety" type="zone_checker_node" name="zone_checker" output="screen" required="true">
      <rosparam command="load" file="$(arg safety_config)"/>
      <param name="obstacle_cloud" value="$(arg obstacle_cloud)"/>
      <remap from="points" to="depth/color/points"/>
    </node>
  </group>
</launch>
