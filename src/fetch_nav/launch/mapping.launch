<launch>
  <!-- 2D SLAM with RTAB-Map from the merged thinned obstacle cloud of the
       left, right and front cameras (/obstacles, cloud_merger in bringup) and
       the robot's odometry (TF odom -> base_link from the armed
       bridge). Scan matching (ICP) refines odometry and closes loops when the
       robot comes back near a place it mapped; there are no images.

       Live:    roslaunch fetch_nav mapping.launch map:=lab
       Offline: roslaunch fetch_nav mapping.launch map:=lab use_sim_time:=true
                then play the bag with its clock (rosbag play, clock option):
                ~/projects/fetch/bags/mapping_lab.bag
       Result:  ~/projects/fetch/maps/lab.db (/rtabmap/grid_map while running;
                save a PGM/YAML with: rosrun map_server map_saver map:=/rtabmap/grid_map -f lab)
       localization:=true reuses the map without changing it.
       camera:=true also uses the front camera's infrared image (bringup
       front_infra:=true) to recognise places by appearance: loop closures
       from a distance and relocalising at startup. -->
  <arg name="map" default="map"/>
  <arg name="database" default="$(env HOME)/projects/fetch/maps/$(arg map).db"/>
  <arg name="localization" default="false"/>
  <!-- mapping starts a new database unless this is false -->
  <arg name="fresh" default="true"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="camera" default="false"/>
  <param name="use_sim_time" value="$(arg use_sim_time)"/>

  <!-- projector dots out of the infrared image (3x3 median) -->
  <node if="$(arg camera)" pkg="fetch_nav" type="ir_filter.py" name="ir_filter" ns="cam_front/infra1">
    <remap from="image" to="image_rect_raw"/>
  </node>

  <group ns="rtabmap">
    <!-- nice: RTAB-Map's heavy updates (>= 0.3 s, ~half the time on the
         2026-10-07 run) held 81% of move_base's slow costmap loops; the
         controller, filter and bridge on this board go first. -->
    <node pkg="rtabmap_ros" type="rtabmap" name="rtabmap" output="screen" launch-prefix="nice -n 10"
          args="$(eval '--delete_db_on_start' if (arg('fresh') and not arg('localization')) else '')">
      <param name="database_path" value="$(arg database)"/>
      <param name="frame_id" value="base_link"/>
      <param name="odom_frame_id" value="odom"/>
      <param name="map_frame_id" value="map"/>
      <param name="subscribe_depth" value="$(arg camera)"/>
      <param name="subscribe_rgb" value="false"/>
      <param name="subscribe_rgbd" value="false"/>
      <param name="subscribe_scan" value="false"/>
      <param name="subscribe_scan_cloud" value="true"/>
      <param name="wait_for_transform_duration" value="0.2"/>
      <remap from="scan_cloud" to="/obstacles"/>
      <!-- camera: the filtered infrared image stands in for "rgb"; the depth
           (212x120) is from the same viewpoint at half its resolution -->
      <param name="approx_sync" value="$(arg camera)"/>
      <param name="queue_size" value="20"/>
      <remap from="rgb/image" to="/cam_front/infra1/image_filtered"/>
      <remap from="rgb/camera_info" to="/cam_front/infra1/camera_info"/>
      <remap from="depth/image" to="/cam_front/depth/image_rect_raw"/>
      <rosparam command="load" file="$(find fetch_nav)/config/rtabmap_2d.yaml"/>
      <rosparam if="$(arg camera)" command="load" file="$(find fetch_nav)/config/rtabmap_camera.yaml"/>
      <param name="Mem/IncrementalMemory" type="string" value="$(eval 'false' if arg('localization') else 'true')"/>
    </node>
  </group>
</launch>
